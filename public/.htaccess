<IfModule mod_headers.c>
  # Always revalidate HTML entry point so new deploys appear immediately.
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # Cache static build assets aggressively (filenames are content-hashed by Vite).
  <FilesMatch "\.(?:js|css|png|jpg|jpeg|gif|svg|webp|avif|ico|woff|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Serve existing files and directories directly (serves prerendered news-events/:id/index.html)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Dynamic fallback for social media crawlers fetching news/events
  RewriteCond %{HTTP_USER_AGENT} (facebookexternalhit|Facebot|Twitterbot|LinkedInBot|WhatsApp|TelegramBot|Discordbot|Slackbot|SkypeUriPreview) [NC]
  RewriteRule ^news-events/([0-9a-zA-Z_-]+)/?$ news-preview.php?id=$1 [L,QSA]

  # All other routes to index.html for React SPA
  RewriteRule ^ index.html [L]
</IfModule>
